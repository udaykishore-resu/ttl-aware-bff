# ===========================================================================
# Go
# ===========================================================================
# Compiled objects and archives.
*.o
*.a
*.so
*.dylib
*.exe
*.exe~
*.dll

# `go test -c` output and profile data.
*.test
*.prof
*.pprof
*.mem
*.cpu
*.trace

# `go build` with no -o writes a binary named after the package directory.
/bff
/opsource
/exsource

# Go workspace files are per-developer.
go.work
go.work.sum

# `go mod vendor` output. Vendoring is the documented air-gapped build path
# (see deploy/docker/Dockerfile.bff), not something to commit.
/vendor/

# ===========================================================================
# Build output
# ===========================================================================
/bin/
/dist/
/out/
/build/

# ===========================================================================
# Coverage and test artefacts
# ===========================================================================
coverage.out
coverage.txt
coverage.html
*.cover
*.coverprofile
.testcache/

# k6 result files.
test/load/*.json
test/load/summary.html

# Compose logs collected by CI on failure.
compose-logs/

# ===========================================================================
# Terraform
# ===========================================================================
# State is the single most dangerous thing that can be committed: it holds
# resource ids and, for some providers, secret values in plaintext.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Provider plugins and module cache.
**/.terraform/
.terraform.tfstate.lock.info

# Variable files typically carry account ids and zone ids. The .example is
# committed; the real one is not.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plans can contain the full resource diff, including secret attributes.
*.tfplan
tfplan
tfplan.*

# Backend partial configs, which may carry a state role ARN.
*.tfbackend

# The lock file IS committed on purpose: it pins provider hashes.
!.terraform.lock.hcl

# ===========================================================================
# Helm
# ===========================================================================
# Packaged charts and vendored subcharts are build output; Chart.lock is
# committed so the Redis dependency is pinned.
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# ===========================================================================
# Kubernetes
# ===========================================================================
# Rendered manifests and anything decrypted locally.
deploy/k8s/**/rendered/
*.dec.yaml
kubeconfig
kubeconfig.*
# The real Secret. secret.example.yaml documents the shape and IS committed.
deploy/k8s/secret.yaml
deploy/k8s/secret.sealed.yaml

# ===========================================================================
# Environment and secrets
# ===========================================================================
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key
credentials
.aws/
.netrc

# ===========================================================================
# Editors and IDEs
# ===========================================================================
.idea/
*.iml
*.ipr
*.iws

.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

*.swp
*.swo
*.swn
*~
.*.sw?

# GoLand / Fleet scratch files.
.run/
.fleet/

# ===========================================================================
# OS
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ===========================================================================
# Third-party sources
# ===========================================================================
# Vendored mirrors used only by the offline build path. They are large, they
# are not ours, and they are reconstructable.
/third_party/

# ===========================================================================
# Tooling caches
# ===========================================================================
.golangci-cache/
.cache/
tmp/
*.log
!scripts/*.log

# go.sum is regenerated by `go mod tidy` on first build. It is not committed
# because the only checksums this repository could be built with offline are
# for the mirror module paths in go.offline.mod, and shipping those would break
# an ordinary build. See OFFLINE-BUILD.md.
/go.sum
